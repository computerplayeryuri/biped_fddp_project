<mxfile host="app.diagrams.net" modified="2026-07-16T00:00:00Z" agent="Codex Drawio Skill" version="24.7.17" type="device">
  <diagram id="mpcCompare01" name="MPC流程对比">
    <mxGraphModel dx="3000" dy="1900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1900" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="一般 MPC 与本项目 FIR-QP-MPC 流程对比" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontFamily=Arial;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="250" y="35" width="2500" height="65" as="geometry"/></mxCell>
        <mxCell id="leftHeader" value="A. 一般 Receding-Horizon MPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=4;fontSize=32;fontStyle=1;fontFamily=Arial;fontColor=#1E3A8A;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="130" width="1300" height="80" as="geometry"/></mxCell>
        <mxCell id="rightHeader" value="B. 本项目 FIR-QP-MPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=32;fontStyle=1;fontFamily=Arial;fontColor=#14532D;spacing=12;" vertex="1" parent="1"><mxGeometry x="1600" y="130" width="1300" height="80" as="geometry"/></mxCell>

        <mxCell id="L1" value="状态测量与参考输入&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;k&lt;/sub&gt;, r&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="270" width="1300" height="180" as="geometry"/></mxCell>
        <mxCell id="L2" value="预测时域&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;X = F(x&lt;sub&gt;k&lt;/sub&gt;, U)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="550" width="1300" height="180" as="geometry"/></mxCell>
        <mxCell id="L3" value="有限时域优化&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;U&lt;sub&gt;k&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt; = arg min&lt;sub&gt;U&lt;/sub&gt; J(x&lt;sub&gt;k&lt;/sub&gt;, U)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="830" width="1300" height="180" as="geometry"/></mxCell>
        <mxCell id="L4" value="执行第一步最优输入&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;u&lt;sub&gt;k&lt;/sub&gt; = u&lt;sub&gt;0|k&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="1110" width="1300" height="180" as="geometry"/></mxCell>
        <mxCell id="L5" value="系统演化；下一采样周期重复&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;k+1&lt;/sub&gt; = f(x&lt;sub&gt;k&lt;/sub&gt;,u&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="1390" width="1300" height="180" as="geometry"/></mxCell>

        <mxCell id="R1" value="名义轨迹与在线测量&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;ref&lt;/sub&gt;(t), θ&lt;sub&gt;k&lt;/sub&gt;, contact events&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1600" y="270" width="1300" height="180" as="geometry"/></mxCell>
        <mxCell id="R2" value="参考时间与俯仰误差&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;φ&lt;/sub&gt; = t + Δt&lt;sub&gt;φ&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;e&lt;sub&gt;k&lt;/sub&gt; = θ&lt;sub&gt;k&lt;/sub&gt; − θ&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;φ&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1600" y="550" width="1300" height="180" as="geometry"/></mxCell>
        <mxCell id="R3" value="FIR + AR 预测；约束 QP&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;E = E&lt;sub&gt;free&lt;/sub&gt; + SA&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;A&lt;sup&gt;*&lt;/sup&gt; = arg min&lt;sub&gt;A&lt;/sub&gt; J&lt;sub&gt;QP&lt;/sub&gt;(A)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1600" y="830" width="1300" height="180" as="geometry"/></mxCell>
        <mxCell id="R4" value="首个控制量与关节映射&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α&lt;sub&gt;k&lt;/sub&gt; = A&lt;sub&gt;0&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;, Δq&lt;sub&gt;k&lt;/sub&gt; = Gα&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1600" y="1110" width="1300" height="180" as="geometry"/></mxCell>
        <mxCell id="R5" value="位置命令&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;φ&lt;/sub&gt;) + Δq&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1600" y="1390" width="1300" height="180" as="geometry"/></mxCell>

        <mxCell id="footer" value="每个采样周期重新求解；仅当计划参考包含接触切换时，C2 才通过事件修正参考时间 tφ。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Arial;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="300" y="1660" width="2400" height="90" as="geometry"/></mxCell>

