  <diagram id="mpcExpandeden" name="Expanded MPC Comparison">
    <mxGraphModel dx="3300" dy="2600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3300" pageHeight="2600" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="Expanded Standard MPC vs Project FIR-QP-MPC" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontFamily=Arial;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="300" y="30" width="2700" height="70" as="geometry"/></mxCell>
        <mxCell id="leftHeader" value="A. Standard Receding-Horizon MPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=4;fontSize=32;fontStyle=1;fontFamily=Arial;fontColor=#111827;spacing=12;" vertex="1" parent="1"><mxGeometry x="100" y="125" width="1450" height="80" as="geometry"/></mxCell>
        <mxCell id="rightHeader" value="B. Project FIR-QP-MPC" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=32;fontStyle=1;fontFamily=Arial;fontColor=#111827;spacing=12;" vertex="1" parent="1"><mxGeometry x="1750" y="125" width="1450" height="80" as="geometry"/></mxCell>
        <mxCell id="L1" value="State measurement / estimation&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x̂&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="250" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="R1" value="Offline nominal references&lt;br&gt;FDDP nominal + C0-aligned pitch reference&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;ref&lt;/sub&gt;(t), θ&lt;sub&gt;ref&lt;/sub&gt;(t)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1750" y="250" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="L2" value="Reference and constraint update&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;r&lt;sub&gt;k:k+N&lt;/sub&gt;, x ∈ X, u ∈ U&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="550" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="R2" value="Online state and contact measurement&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;θ&lt;sub&gt;k&lt;/sub&gt;, θ̇&lt;sub&gt;k&lt;/sub&gt;, toe/heel contact&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1750" y="550" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="L3" value="Horizon prediction&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;X = F(x̂&lt;sub&gt;k&lt;/sub&gt;,U)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="850" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="R3" value="Contact-event phase alignment&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;φ&lt;/sub&gt; = clip(t + Δt&lt;sub&gt;φ&lt;/sub&gt;,0,T)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1750" y="850" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="L4" value="Objective construction&lt;br&gt;tracking + control effort + terminal cost&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;J = Σ∥x-r∥&lt;sub&gt;Q&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; + ∥u∥&lt;sub&gt;R&lt;/sub&gt;&lt;sup&gt;2&lt;/sup&gt; + V&lt;sub&gt;f&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="1150" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="R4" value="Reference-aligned error and known-response separation&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;e&lt;sub&gt;k&lt;/sub&gt; = θ&lt;sub&gt;k&lt;/sub&gt; − θ&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;φ&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;d&lt;sub&gt;k&lt;/sub&gt; = e&lt;sub&gt;k&lt;/sub&gt; − Σh&lt;sub&gt;i&lt;/sub&gt;α&lt;sub&gt;k-i&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1750" y="1150" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="L5" value="QP / NLP solution&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;U&lt;sub&gt;k&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt; = arg min&lt;sub&gt;U&lt;/sub&gt; J(x̂&lt;sub&gt;k&lt;/sub&gt;,U)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="1450" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="R5" value="AR natural response + FIR command-response forecast&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;E = E&lt;sub&gt;free&lt;/sub&gt; + SA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1750" y="1450" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="L6" value="Apply the first optimal input&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;u&lt;sub&gt;k&lt;/sub&gt; = u&lt;sub&gt;0|k&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="1750" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="R6" value="Amplitude / slew constrained QP; first correction&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;A&lt;sup&gt;*&lt;/sup&gt; = arg min q∥E&lt;sub&gt;free&lt;/sub&gt;+SA∥&lt;sup&gt;2&lt;/sup&gt; + r∥A∥&lt;sup&gt;2&lt;/sup&gt; + s∥DA-d&lt;sub&gt;prev&lt;/sub&gt;∥&lt;sup&gt;2&lt;/sup&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α&lt;sub&gt;k&lt;/sub&gt;=A&lt;sub&gt;0&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;, Δq&lt;sub&gt;k&lt;/sub&gt;=Gα&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1750" y="1750" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="L7" value="Plant evolution; advance one sample&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;k+1&lt;/sub&gt; = f(x&lt;sub&gt;k&lt;/sub&gt;,u&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="100" y="2050" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="R7" value="Position command and actuator proxy&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;φ&lt;/sub&gt;) + Δq&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1750" y="2050" width="1450" height="190" as="geometry"/></mxCell>
        <mxCell id="footer" value="Both pipelines re-predict, re-optimise, and apply only the first action at each sample.&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;τ&lt;sub&gt;ref&lt;/sub&gt;&lt;/span&gt;&lt;br&gt; is analysis-only; the runtime output is the position command &lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;." style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Arial;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="300" y="2320" width="2700" height="130" as="geometry"/></mxCell>
