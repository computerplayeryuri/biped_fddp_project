        <mxCell id="C0" value="&lt;b style=&quot;font-size:32px;&quot;&gt;C0 — Reference only&lt;/b&gt;&lt;br&gt;&lt;br&gt;FDDP nominal reference&lt;br&gt;Fixed reference time&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t)&lt;/span&gt;&lt;br&gt;&lt;br&gt;Baseline replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;strokeWidth=4;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=20;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="100" y="210" width="900" height="650" as="geometry"/></mxCell>
        <mxCell id="C1" value="&lt;b style=&quot;font-size:32px;&quot;&gt;C1 — FIR-QP pitch recovery&lt;/b&gt;&lt;br&gt;&lt;br&gt;Pitch-error feedback&lt;br&gt;FIR + AR + constrained QP&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t) + Gα&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;Active recovery; fixed phase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=20;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1200" y="210" width="900" height="650" as="geometry"/></mxCell>
        <mxCell id="C2" value="&lt;b style=&quot;font-size:32px;&quot;&gt;C2 — Contact-phase sync&lt;/b&gt;&lt;br&gt;&lt;br&gt;C1 controller retained&lt;br&gt;Toe/heel event observation&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;φ&lt;/sub&gt; = t + Δt&lt;sub&gt;φ&lt;/sub&gt;&lt;/span&gt; (bounded)&lt;br&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;φ&lt;/sub&gt;) + Gα&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;&lt;br&gt;Phase-aware alignment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=4;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=20;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="2300" y="210" width="900" height="650" as="geometry"/></mxCell>

