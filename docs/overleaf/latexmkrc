$pdf_mode = 5;

# Overleaf's project compiler setting may invoke latexmk with PDF mode even
# when an individual source file requests XeLaTeX. Route both PDF and XeLaTeX
# commands through XeLaTeX so the standalone Chinese guide builds reliably.
$pdflatex = 'xelatex %O %S';
$xelatex = 'xelatex %O %S';
