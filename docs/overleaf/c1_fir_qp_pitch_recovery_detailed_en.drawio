<mxfile host="app.diagrams.net" modified="2026-07-16T00:00:00Z" agent="Codex Drawio Skill" version="24.7.17" type="device">
  <diagram id="c1Detaileden" name="C1 Detailed Flow">
    <mxGraphModel dx="2600" dy="3150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="3150" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C1 - FIR-QP Pitch-Recovery Detailed Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontFamily=Arial;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="2100" height="70" as="geometry"/></mxCell>
        <mxCell id="offlineHeader" value="Offline identification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="2000" height="65" as="geometry"/></mxCell>
        <mxCell id="onlineHeader" value="Online receding-horizon control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="300" y="920" width="2000" height="65" as="geometry"/></mxCell>
        <mxCell id="P1" value="FDDP nominal + C0-aligned pitch reference&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;ref&lt;/sub&gt;(t), θ&lt;sub&gt;ref&lt;/sub&gt;(t)&lt;/span&gt;&lt;br&gt;fixed-phase C1 reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P2" value="Identify the empirical pulse response&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α pulse → root-pitch deviation&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;h = [h&lt;sub&gt;0&lt;/sub&gt;,…,h&lt;sub&gt;M−1&lt;/sub&gt;]&lt;/span&gt;&lt;br&gt;obtain FIR response coefficients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P3" value="Fit and stabilise the AR disturbance model&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;d&lt;sub&gt;k&lt;/sub&gt; = Σa&lt;sub&gt;j&lt;/sub&gt;d&lt;sub&gt;k−j&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;check / contract the spectral radius" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="710" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P4" value="Measure pitch and form the reference-aligned error&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;e&lt;sub&gt;k&lt;/sub&gt; = θ&lt;sub&gt;meas,k&lt;/sub&gt; − θ&lt;sub&gt;ref&lt;/sub&gt;(t)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1010" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P5" value="Subtract the known delayed response of past commands&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;d&lt;sub&gt;k&lt;/sub&gt; = e&lt;sub&gt;k&lt;/sub&gt; − Σh&lt;sub&gt;i&lt;/sub&gt;α&lt;sub&gt;k−i&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1260" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P6" value="Forecast the free response and build the FIR dynamic matrix&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;E&lt;sub&gt;free&lt;/sub&gt; = E&lt;sub&gt;AR&lt;/sub&gt; + E&lt;sub&gt;past&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;E = E&lt;sub&gt;free&lt;/sub&gt; + SA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1510" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P7" value="Solve the tracking / magnitude / slew QP&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;A&lt;sup&gt;*&lt;/sup&gt; = arg min q∥E&lt;sub&gt;free&lt;/sub&gt;+SA∥&lt;sup&gt;2&lt;/sup&gt; + r∥A∥&lt;sup&gt;2&lt;/sup&gt; + s∥DA-d&lt;sub&gt;prev&lt;/sub&gt;∥&lt;sup&gt;2&lt;/sup&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;|A&lt;sub&gt;i&lt;/sub&gt;| ≤ α&lt;sub&gt;max&lt;/sub&gt;, |Δα| ≤ Δα&lt;sub&gt;max&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1760" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P8" value="Apply only the first element of the optimal sequence&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α&lt;sub&gt;k&lt;/sub&gt; = A&lt;sub&gt;0&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2010" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P9" value="Map to joint correction and position command&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;Δq&lt;sub&gt;k&lt;/sub&gt; = Gα&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t) + Δq&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2260" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P10" value="Compute and check acceptance metrics&lt;br&gt;IAE / peak and final pitch error / minimum contacts&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;max |Δq|&lt;/span&gt;&lt;br&gt;/ median and maximum QP solve time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2510" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="evidence" value="Evidence boundary: C1 improves post-disturbance recovery relative to C0; it does not claim elimination of the initial peak at disturbance injection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#7C2D12;spacing=16;" vertex="1" parent="1"><mxGeometry x="300" y="2790" width="2000" height="190" as="geometry"/></mxCell>
        <mxCell id="E_P1_P2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#475569;strokeWidth=3;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P1" target="P2"><mxGeometry relative="1" as="geometry"/></mxCell>
