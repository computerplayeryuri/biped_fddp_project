  <diagram id="c1Detaileden" name="C1 Detailed Flow">
    <mxGraphModel dx="2600" dy="3150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="3150" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="C1 — Current Fixed-Phase FIR-QP Pitch-Recovery Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontFamily=Arial;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="2100" height="70" as="geometry" /></mxCell>
        <mxCell id="offlineHeader" value="Offline Identification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="2000" height="65" as="geometry" /></mxCell>
        <mxCell id="onlineHeader" value="Online Fixed-Phase FIR-QP + Safety" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="300" y="920" width="2000" height="65" as="geometry" /></mxCell>
        <mxCell id="P1" value="Accepted Ten-Step Joint Reference + Nominal MuJoCo Pitch Baseline&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;ref&lt;/sub&gt;(t), θ&lt;sub&gt;baseline&lt;/sub&gt;(t)&lt;/span&gt;&lt;br&gt;fixed-phase pitch reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P2" value="Identify the Empirical Pulse Response&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α pulse → root-pitch deviation&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;h = [h&lt;sub&gt;0&lt;/sub&gt;,…,h&lt;sub&gt;M−1&lt;/sub&gt;]&lt;/span&gt;; obtain FIR coefficients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P3" value="Fit and Check the AR Natural-Response Model&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;d&lt;sub&gt;k&lt;/sub&gt; = Σa&lt;sub&gt;j&lt;/sub&gt;d&lt;sub&gt;k−j&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;check and contract the spectral radius when required" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="710" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P4" value="Measure Pitch and Form the Fixed-Time Error&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;e&lt;sub&gt;k&lt;/sub&gt; = θ&lt;sub&gt;meas,k&lt;/sub&gt; − θ&lt;sub&gt;baseline&lt;/sub&gt;(t)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1010" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P5" value="Remove the Known Delayed Response of Past Commands&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;d&lt;sub&gt;k&lt;/sub&gt; = e&lt;sub&gt;k&lt;/sub&gt; − Σh&lt;sub&gt;i&lt;/sub&gt;α&lt;sub&gt;k−i&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1260" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P6" value="Forecast the Free Response and Build the FIR Dynamic Matrix&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;E&lt;sub&gt;free&lt;/sub&gt; = E&lt;sub&gt;AR&lt;/sub&gt; + E&lt;sub&gt;past&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;E = E&lt;sub&gt;free&lt;/sub&gt; + SA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1510" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P7" value="Solve the Tracking / Magnitude / Slew-Cost QP&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;A&lt;sup&gt;*&lt;/sup&gt; = arg min q∥E&lt;sub&gt;free&lt;/sub&gt;+SA∥² + r∥A∥² + s∥DA−d&lt;sub&gt;prev&lt;/sub&gt;∥²&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;|A&lt;sub&gt;i&lt;/sub&gt;| ≤ α&lt;sub&gt;max&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1760" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P8" value="Select the FIR-QP Parameters and Apply the First Action&lt;br&gt;normal parameters; recovery parameters when &lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;|e&lt;sub&gt;k&lt;/sub&gt;| ≥ 3°&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α&lt;sub&gt;k&lt;/sub&gt; = clip(A&lt;sub&gt;0&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;, α&lt;sub&gt;k−1&lt;/sub&gt; ± Δα&lt;sub&gt;max&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2010" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P9" value="Project to Joint Limits and Form the Safe Position Command&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;cmd&lt;/sub&gt; = clip(t + 0.030,0,T)&lt;/span&gt;; project &lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt; to the joint-feasible interval&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = SafetyLimiter(q&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;cmd&lt;/sub&gt;) + Gα&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2260" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P10" value="Compute and Check C1 Evidence&lt;br&gt;IAE / peak and final pitch error / contacts / height&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;max|Δq|&lt;/span&gt; / limiter activity / saturation / controller state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2510" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="evidence" value="Current evidence: accepted ten-step simulation shows C1 recovery improvement relative to C0. C1 remains fixed-phase and does not use contact-event phase correction. Hardware walking is not yet validated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#7C2D12;spacing=16;" vertex="1" parent="1"><mxGeometry x="300" y="2790" width="2000" height="190" as="geometry" /></mxCell>
