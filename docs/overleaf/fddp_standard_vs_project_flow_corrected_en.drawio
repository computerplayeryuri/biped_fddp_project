        <mxCell id="L1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Finite-Horizon Nonlinear OCP&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;min Σ ℓ&lt;sub&gt;k&lt;/sub&gt;(x&lt;sub&gt;k&lt;/sub&gt;,u&lt;sub&gt;k&lt;/sub&gt;) + ℓ&lt;sub&gt;N&lt;/sub&gt;(x&lt;sub&gt;N&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;k+1&lt;/sub&gt; = f&lt;sub&gt;k&lt;/sub&gt;(x&lt;sub&gt;k&lt;/sub&gt;,u&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="1400" x="120" y="230" as="geometry" />
        </mxCell>
        <mxCell id="L2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Initialise Nominal Trajectory&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x̄&lt;sub&gt;0:N&lt;/sub&gt;, ū&lt;sub&gt;0:N−1&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;FDDP permits a temporarily infeasible state-control trajectory" vertex="1">
          <mxGeometry height="150" width="1400" x="120" y="430" as="geometry" />
        </mxCell>
        <mxCell id="L3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Evaluate Cost and Shooting Gaps&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;J(x̄,ū), g&lt;sub&gt;k+1&lt;/sub&gt; = f&lt;sub&gt;k&lt;/sub&gt;(x̄&lt;sub&gt;k&lt;/sub&gt;,ū&lt;sub&gt;k&lt;/sub&gt;) ⊖ x̄&lt;sub&gt;k+1&lt;/sub&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="1400" x="120" y="630" as="geometry" />
        </mxCell>
        <mxCell id="L4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Backward Pass: Local Quadratic Approximation and Riccati Recursion&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;δu&lt;sub&gt;k&lt;/sub&gt; = −k&lt;sub&gt;k&lt;/sub&gt; − K&lt;sub&gt;k&lt;/sub&gt;δx&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;Crocoddyl convention: feedforward k&lt;sub&gt;k&lt;/sub&gt;, feedback K&lt;sub&gt;k&lt;/sub&gt;" vertex="1">
          <mxGeometry height="150" width="1400" x="120" y="830" as="geometry" />
        </mxCell>
        <mxCell id="L5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Forward Rollout + Line Search&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;u&lt;sub&gt;k&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = ū&lt;sub&gt;k&lt;/sub&gt; − αk&lt;sub&gt;k&lt;/sub&gt; − K&lt;sub&gt;k&lt;/sub&gt;(x&lt;sub&gt;k&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; ⊖ x̄&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α ∈ (0,1]&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="1400" x="120" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="4KAnFSzlPXPTHq7SJWvd-1" edge="1" parent="1" source="L6" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;" target="L5" value="">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="L6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#7C2D12;spacing=10;" value="Line-Search Candidate Acceptable?&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;ΔV&lt;sub&gt;actual&lt;/sub&gt; &amp;gt; κΔV&lt;sub&gt;expected&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;When infeasible, a small cost increase may be accepted to reduce gaps" vertex="1">
          <mxGeometry height="150" width="880" x="380" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="Lfail" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=3;dashed=1;fontSize=26;fontFamily=Arial;fontColor=#7F1D1D;spacing=10;" value="Reject Candidate&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α ↓, λ&lt;sub&gt;reg&lt;/sub&gt; ↑&lt;/span&gt;&lt;br&gt;Repeat backward pass" vertex="1">
          <mxGeometry height="145" width="260" x="1260" y="1245" as="geometry" />
        </mxCell>
        <mxCell id="L7" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#7C2D12;spacing=10;" value="Solver Converged?&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;feasible and stop &amp;lt; ε&lt;/span&gt;&lt;br&gt;Project-level gate separately checks &lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;max∥g&lt;sub&gt;k&lt;/sub&gt;∥ ≤ ε&lt;sub&gt;g&lt;/sub&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="880" x="380" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="L8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=4;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#1E3A8A;spacing=14;" value="Output Locally Optimal Trajectory and Local Control Policy&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;0:N&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;, u&lt;sub&gt;0:N−1&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;, K&lt;sub&gt;0:N−1&lt;/sub&gt;&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="1400" x="120" y="1660" as="geometry" />
        </mxCell>
        <mxCell id="Lnote" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=3;dashed=1;fontSize=26;fontFamily=Arial;fontColor=#1E3A8A;spacing=14;" value="Key Distinction from Classical DDP&lt;br&gt;The backward pass can handle infeasible trajectories; early rollouts may retain and progressively reduce shooting gaps." vertex="1">
          <mxGeometry height="145" width="1400" x="120" y="1870" as="geometry" />
        </mxCell>
        <mxCell id="R1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Model and Actuator Boundaries&lt;br&gt;URDF → Pinocchio → Crocoddyl&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;n&lt;sub&gt;q&lt;/sub&gt; = 13, n&lt;sub&gt;v&lt;/sub&gt; = 12, τ&lt;sub&gt;ref&lt;/sub&gt;: analysis only&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="1400" x="1880" y="230" as="geometry" />
        </mxCell>
        <mxCell id="R2" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Fixed Contact Sequence and Multi-Contact OCP&lt;br&gt;DS → Right stance / Left swing → DS → Left stance / Right swing → DS&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;k&lt;/sub&gt; = (q&lt;sub&gt;k&lt;/sub&gt;,v&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;; support / swing / CoM / regularisation costs" vertex="1">
          <mxGeometry height="150" width="1400" x="1880" y="430" as="geometry" />
        </mxCell>
        <mxCell id="R3" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Two-Step Alternating FDDP&lt;br&gt;Left swing + Right swing&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;stop = 2.84×10&lt;sup&gt;−8&lt;/sup&gt;, max ∥g&lt;sub&gt;k&lt;/sub&gt;∥ = 0&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="1400" x="1880" y="630" as="geometry" />
        </mxCell>
        <mxCell id="R4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Periodic Cycle + 7-Stage Homotopy&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;N&lt;/sub&gt; ⊖ T&lt;sub&gt;Δy&lt;/sub&gt;(x&lt;sub&gt;0&lt;/sub&gt;) → 0, Δy = 10 mm&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;u&lt;sub&gt;0&lt;/sub&gt;,u&lt;sub&gt;N−1&lt;/sub&gt; → u&lt;sub&gt;qs&lt;/sub&gt; = 0 ⇒ u&lt;sub&gt;N−1&lt;/sub&gt; − u&lt;sub&gt;0&lt;/sub&gt; → 0&lt;/span&gt;; 7/7 converged" vertex="1">
          <mxGeometry height="150" width="1400" x="1880" y="830" as="geometry" />
        </mxCell>
        <mxCell id="R5" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Multi-Step Continuation&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;2 → 4 → 6 → 10 steps&lt;/span&gt;&lt;br&gt;Final: &lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;N = 1000, Δt = 0.01 s, T = 10 s&lt;/span&gt;" vertex="1">
          <mxGeometry height="150" width="1400" x="1880" y="1030" as="geometry" />
        </mxCell>
        <mxCell id="R6" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#7C2D12;spacing=10;" value="Segment Planning Gates Passed?&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;stop ≤ 10&lt;sup&gt;−7&lt;/sup&gt;, max∥g&lt;sub&gt;k&lt;/sub&gt;∥ ≤ 10&lt;sup&gt;−7&lt;/sup&gt;&lt;/span&gt;&lt;br&gt;trajectory gates + embedded planar-contact checks" vertex="1">
          <mxGeometry height="150" width="880" x="2140" y="1240" as="geometry" />
        </mxCell>
        <mxCell id="Rfail1" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=3;dashed=1;fontSize=26;fontFamily=Arial;fontColor=#7F1D1D;spacing=10;" value="FAIL&lt;br&gt;Stop Current Ladder&lt;br&gt;No New Candidate" vertex="1">
