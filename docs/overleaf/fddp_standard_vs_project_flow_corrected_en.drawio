        <mxCell id="R7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" value="Independent Contact Re-Extraction and Promotion Audit&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;F&lt;sub&gt;z&lt;/sub&gt;, η&lt;sub&gt;μ&lt;/sub&gt; = |F&lt;sub&gt;y&lt;/sub&gt;|/(μF&lt;sub&gt;z&lt;/sub&gt;), y&lt;sub&gt;CoP&lt;/sub&gt; = M&lt;sub&gt;x&lt;/sub&gt;/F&lt;sub&gt;z&lt;/sub&gt;, v&lt;sub&gt;t&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;planar resultant / sagittal margin / slip; out-of-plane: diagnostics only" vertex="1">
          <mxGeometry height="150" width="1400" x="1880" y="1450" as="geometry" />
        </mxCell>
        <mxCell id="R8" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#7C2D12;spacing=10;" value="Contact Gates Passed?&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;F&lt;sub&gt;z&lt;/sub&gt; &amp;gt; 0, η&lt;sub&gt;μ&lt;/sub&gt; ≤ 0.90&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;margin&lt;sub&gt;CoP&lt;/sub&gt; ≥ 2 mm, v&lt;sub&gt;t&lt;/sub&gt; ≤ 10&lt;sup&gt;−3&lt;/sup&gt; m/s&lt;/span&gt;" vertex="1">
