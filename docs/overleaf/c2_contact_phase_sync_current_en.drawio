  <diagram id="c2Detaileden" name="C2 Detailed Flow">
    <mxGraphModel dx="2600" dy="3200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="3200" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="C2-Final — Predictive Contact-Phase Synchronisation + FIR-QP" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontFamily=Arial;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="2100" height="70" as="geometry" /></mxCell>
        <mxCell id="prepHeader" value="Reference and Contact-Event Preparation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="2000" height="65" as="geometry" /></mxCell>
        <mxCell id="onlineHeader" value="Predictive Phase Alignment + C1 FIR-QP" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="2000" height="65" as="geometry" /></mxCell>
        <mxCell id="P1" value="Reuse the Current C1 Models and Safety Stack&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;h, AR, q/r/slew, G, recovery FIR-QP, SafetyLimiter&lt;/span&gt;&lt;br&gt;the pitch-recovery core remains fixed-phase" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P2" value="Load Scheduled Events from the Accepted Ten-Step Reference&lt;br&gt;left / right liftoff and touchdown&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;{leg, kind, t&lt;sub&gt;event,ref&lt;/sub&gt;}; 20 scheduled events&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P3" value="Toe / Heel Contact Observer&lt;br&gt;sensor values → site active → leg active&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;observed events: {leg, kind, t&lt;sub&gt;obs&lt;/sub&gt;}&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="790" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P4" value="Match Observed and Expected Events inside the Time Window&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;ε&lt;sub&gt;t&lt;/sub&gt; = t&lt;sub&gt;obs&lt;/sub&gt; − t&lt;sub&gt;expected&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;matched / skipped / unmatched; preserve event order" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1040" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P5" value="Compute the Predictive Bounded Phase-Offset Update&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;Δt&lt;sub&gt;target&lt;/sub&gt; = clip(ε&lt;sub&gt;t&lt;/sub&gt;, ±Δt&lt;sub&gt;max&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;Δt&lt;sub&gt;φ&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = clip(Δt&lt;sub&gt;φ&lt;/sub&gt; + clip(K&lt;sub&gt;φ&lt;/sub&gt;(Δt&lt;sub&gt;target&lt;/sub&gt;−Δt&lt;sub&gt;φ&lt;/sub&gt;), ±δt&lt;sub&gt;step&lt;/sub&gt;), ±Δt&lt;sub&gt;max&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1290" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P6" value="Query the Event-Specific Phase Time&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;φ&lt;/sub&gt; = clip(t + Δt&lt;sub&gt;φ&lt;/sub&gt;,0,T)&lt;/span&gt;&lt;br&gt;select the stored offset for the next expected contact kind" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1540" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P7" value="Build the Leg-Selective Command Reference&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;base&lt;/sub&gt; = clip(t+0.030,0,T), t&lt;sub&gt;phase&lt;/sub&gt; = clip(t&lt;sub&gt;φ&lt;/sub&gt;+0.030,0,T)&lt;/span&gt;&lt;br&gt;start from &lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;base&lt;/sub&gt;)&lt;/span&gt;; replace only the next-event leg with &lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;phase&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;pitch reference remains &lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;θ&lt;sub&gt;baseline&lt;/sub&gt;(t)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1790" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P8" value="Run the C1 FIR-QP Pitch Correction&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;e&lt;sub&gt;k&lt;/sub&gt; → E&lt;sub&gt;free&lt;/sub&gt;+SA → A&lt;sup&gt;*&lt;/sup&gt; → α&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;normal / recovery parameter selection is unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2040" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P9" value="Project, Limit, and Form the Runtime Position Command&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α&lt;sub&gt;k&lt;/sub&gt; ← joint-feasible projection&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = SafetyLimiter(q&lt;sub&gt;ref,hybrid&lt;/sub&gt; + Gα&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2290" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="P10" value="Log C2 Evidence&lt;br&gt;matched / skipped events; timing error / phase offset&lt;br&gt;contacts / pitch / correction / limiter / controller state" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2540" width="2000" height="180" as="geometry" /></mxCell>
        <mxCell id="evidence" value="Current evidence: accepted ten-step MuJoCo ablation matched 20/20 scheduled contact events with valid order, and all C2 checks passed. Evidence is simulation-only; hardware walking is not yet validated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#7C2D12;spacing=16;" vertex="1" parent="1"><mxGeometry x="300" y="2810" width="2000" height="240" as="geometry" /></mxCell>
