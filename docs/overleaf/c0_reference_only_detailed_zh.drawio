<mxfile host="app.diagrams.net" modified="2026-07-16T00:00:00Z" agent="Codex Drawio Skill" version="24.7.17" type="device">
  <diagram id="c0Detailedzh" name="C0详细流程">
    <mxGraphModel dx="2400" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2400" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C0 - Reference-only 基线详细流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontFamily=Arial;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="1900" height="70" as="geometry"/></mxCell>
        <mxCell id="section" value="固定相位名义参考回放" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="1800" height="70" as="geometry"/></mxCell>
        <mxCell id="P1" value="加载 FDDP 完整名义参考&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;ref&lt;/sub&gt;, q&lt;sub&gt;ref&lt;/sub&gt;, dq&lt;sub&gt;ref&lt;/sub&gt;, x&lt;sub&gt;ref&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;phase / contact metadata" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="1800" height="170" as="geometry"/></mxCell>
        <mxCell id="P2" value="使用固定参考时钟&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;query&lt;/sub&gt; = t&lt;/span&gt;&lt;br&gt;无 contact-event phase correction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="1800" height="170" as="geometry"/></mxCell>
        <mxCell id="P3" value="插值名义关节与俯仰参考&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;nom&lt;/sub&gt; = interp(t,q&lt;sub&gt;ref&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;θ&lt;sub&gt;ref&lt;/sub&gt; = interp(t,pitch&lt;sub&gt;ref&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="770" width="1800" height="170" as="geometry"/></mxCell>
        <mxCell id="P4" value="不使用反馈修正&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α&lt;sub&gt;k&lt;/sub&gt; = 0, Δq&lt;sub&gt;k&lt;/sub&gt; = 0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1040" width="1800" height="170" as="geometry"/></mxCell>
        <mxCell id="P5" value="形成位置命令&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1310" width="1800" height="170" as="geometry"/></mxCell>
        <mxCell id="P6" value="Position proxy 与 MuJoCo actuator application&lt;br&gt;position / rate limiting → data.ctrl → mj_step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1580" width="1800" height="170" as="geometry"/></mxCell>
        <mxCell id="P7" value="注入俯仰扰动并记录基线指标&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;e&lt;sub&gt;θ&lt;/sub&gt; = θ&lt;sub&gt;meas&lt;/sub&gt; − θ&lt;sub&gt;ref&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;pitch error / height / contacts / joint tracking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1850" width="1800" height="170" as="geometry"/></mxCell>
        <mxCell id="evidence" value="证据边界：C0 是 reference-only disturbance baseline，不是 MPC 控制器；它提供固定相位参考，用于量化 C1 的恢复改进。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#7C2D12;spacing=16;" vertex="1" parent="1"><mxGeometry x="300" y="2120" width="1800" height="170" as="geometry"/></mxCell>
