<mxfile host="app.diagrams.net" modified="2026-07-16T00:00:00Z" agent="Codex Drawio Skill" version="24.7.17" type="device">
  <diagram id="fddpCompare01" name="FDDP流程对比">
    <mxGraphModel dx="3400" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3400" pageHeight="2400" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="标准 FDDP 与本项目 FDDP 工程流程对比" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontFamily=Arial;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="2900" height="65" as="geometry"/></mxCell>
        <mxCell id="leftHeader" value="A. 标准 FDDP 求解循环（算法本体） [1–3]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=4;fontSize=32;fontStyle=1;fontFamily=Arial;fontColor=#1E3A8A;spacing=12;" vertex="1" parent="1"><mxGeometry x="120" y="110" width="1400" height="75" as="geometry"/></mxCell>
        <mxCell id="rightHeader" value="B. 本项目流程（FDDP + continuation + evidence gates）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=32;fontStyle=1;fontFamily=Arial;fontColor=#14532D;spacing=12;" vertex="1" parent="1"><mxGeometry x="1880" y="110" width="1400" height="75" as="geometry"/></mxCell>
        <mxCell id="divider" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#CBD5E1;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="1698" y="110" width="4" height="2180" as="geometry"/></mxCell>
        <mxCell id="L1" value="有限时域非线性 OCP&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;min Σ ℓ&lt;sub&gt;k&lt;/sub&gt;(x&lt;sub&gt;k&lt;/sub&gt;,u&lt;sub&gt;k&lt;/sub&gt;) + ℓ&lt;sub&gt;N&lt;/sub&gt;(x&lt;sub&gt;N&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;k+1&lt;/sub&gt; = f&lt;sub&gt;k&lt;/sub&gt;(x&lt;sub&gt;k&lt;/sub&gt;,u&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="120" y="230" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="L2" value="初始化 nominal trajectory&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x̄&lt;sub&gt;0:N&lt;/sub&gt;, ū&lt;sub&gt;0:N−1&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;FDDP 允许初始状态—控制轨迹暂时 infeasible" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="120" y="430" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="L3" value="计算 cost 与 shooting gaps&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;J(x̄,ū), g&lt;sub&gt;k+1&lt;/sub&gt; = f&lt;sub&gt;k&lt;/sub&gt;(x̄&lt;sub&gt;k&lt;/sub&gt;,ū&lt;sub&gt;k&lt;/sub&gt;) ⊖ x̄&lt;sub&gt;k+1&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="120" y="630" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="L4" value="Backward pass：局部二次近似与 Riccati 递推&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;δu&lt;sub&gt;k&lt;/sub&gt; = k&lt;sub&gt;k&lt;/sub&gt; + K&lt;sub&gt;k&lt;/sub&gt;δx&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;得到 feedforward k&lt;sub&gt;k&lt;/sub&gt; 与 feedback K&lt;sub&gt;k&lt;/sub&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="120" y="830" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="L5" value="Forward rollout + line search&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;u&lt;sub&gt;k&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = ū&lt;sub&gt;k&lt;/sub&gt; + αk&lt;sub&gt;k&lt;/sub&gt; + K&lt;sub&gt;k&lt;/sub&gt;(x&lt;sub&gt;k&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; ⊖ x̄&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α ∈ (0,1]&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="120" y="1030" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="L6" value="候选轨迹可接受？&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;ΔJ &lt; 0 且 ∥g&lt;sup&gt;+&lt;/sup&gt;∥ ≤ ∥ḡ∥&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#7C2D12;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="1240" width="880" height="150" as="geometry"/></mxCell>
        <mxCell id="Lfail" value="拒绝候选&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α ↓， μ ↑&lt;/span&gt;&lt;br&gt;重新 backward pass" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=3;dashed=1;fontSize=26;fontFamily=Arial;fontColor=#7F1D1D;spacing=10;" vertex="1" parent="1"><mxGeometry x="1260" y="1245" width="260" height="145" as="geometry"/></mxCell>
        <mxCell id="L7" value="收敛？&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;stop &lt; ε 且 ∥g∥ &lt; ε&lt;sub&gt;g&lt;/sub&gt;&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#7C2D12;spacing=10;" vertex="1" parent="1"><mxGeometry x="380" y="1450" width="880" height="150" as="geometry"/></mxCell>
        <mxCell id="L8" value="输出最优轨迹与局部控制策略&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;0:N&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;, u&lt;sub&gt;0:N−1&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;, K&lt;sub&gt;0:N−1&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=4;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#1E3A8A;spacing=14;" vertex="1" parent="1"><mxGeometry x="120" y="1660" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="Lnote" value="FDDP 相对经典 DDP 的关键点&lt;br&gt;Backward pass 可处理 infeasible trajectory；早期 rollout 可保留并逐步缩小 gaps。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#60A5FA;strokeWidth=3;dashed=1;fontSize=26;fontFamily=Arial;fontColor=#1E3A8A;spacing=14;" vertex="1" parent="1"><mxGeometry x="120" y="1870" width="1400" height="145" as="geometry"/></mxCell>
        <mxCell id="R1" value="模型与执行器边界&lt;br&gt;URDF → Pinocchio → Crocoddyl&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;n&lt;sub&gt;q&lt;/sub&gt; = 13, n&lt;sub&gt;v&lt;/sub&gt; = 12, τ&lt;sub&gt;ref&lt;/sub&gt;: analysis only&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1880" y="230" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="R2" value="固定接触序列与 multi-contact OCP&lt;br&gt;DS → Left SS → DS → Right SS → DS&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;k&lt;/sub&gt; = (q&lt;sub&gt;k&lt;/sub&gt;,v&lt;sub&gt;k&lt;/sub&gt;)&lt;/span&gt;；support / swing / CoM / regularisation costs" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1880" y="430" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="R3" value="两步交替 FDDP&lt;br&gt;Left swing + Right swing&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;stop = 2.84×10&lt;sup&gt;−8&lt;/sup&gt;, max ∥g&lt;sub&gt;k&lt;/sub&gt;∥ = 0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1880" y="630" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="R4" value="Periodic cycle + 7-stage homotopy&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;x&lt;sub&gt;N&lt;/sub&gt; ⊖ T(x&lt;sub&gt;0&lt;/sub&gt;) → 0&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;u&lt;sub&gt;N−1&lt;/sub&gt; − u&lt;sub&gt;0&lt;/sub&gt; → 0&lt;/span&gt;；7/7 stages converged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1880" y="830" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="R5" value="多步 continuation&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;2 → 4 → 6 → 10 steps&lt;/span&gt;&lt;br&gt;Final: &lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;N = 1000, Δt = 0.01 s, T = 10 s&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1880" y="1030" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="R6" value="Planning gates 通过？&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;stop ≤ ε, max∥g&lt;sub&gt;k&lt;/sub&gt;∥ ≤ ε&lt;sub&gt;g&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;support / landing / clearance / joint margin / CoM" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#7C2D12;spacing=10;" vertex="1" parent="1"><mxGeometry x="2140" y="1240" width="880" height="150" as="geometry"/></mxCell>
        <mxCell id="Rfail1" value="FAIL&lt;br&gt;保留 diagnostics&lt;br&gt;不进入 final promotion" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=3;dashed=1;fontSize=26;fontFamily=Arial;fontColor=#7F1D1D;spacing=10;" vertex="1" parent="1"><mxGeometry x="3025" y="1245" width="255" height="145" as="geometry"/></mxCell>
        <mxCell id="R7" value="接触可行性提取与审计&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;F&lt;sub&gt;z&lt;/sub&gt;, η&lt;sub&gt;μ&lt;/sub&gt; = ∥F&lt;sub&gt;t&lt;/sub&gt;∥/(μF&lt;sub&gt;z&lt;/sub&gt;), CoP, v&lt;sub&gt;t&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;resultant force / friction / polygon margin / slip" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="1880" y="1450" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="R8" value="Contact gates 通过？&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;F&lt;sub&gt;z&lt;/sub&gt; ≥ −10&lt;sup&gt;−5&lt;/sup&gt; N, η&lt;sub&gt;μ&lt;/sub&gt; ≤ 0.90&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;margin&lt;sub&gt;CoP&lt;/sub&gt; ≥ 2 mm, v&lt;sub&gt;t&lt;/sub&gt; ≤ 10&lt;sup&gt;−3&lt;/sup&gt; m/s&lt;/span&gt;" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#7C2D12;spacing=10;" vertex="1" parent="1"><mxGeometry x="2140" y="1650" width="880" height="160" as="geometry"/></mxCell>
        <mxCell id="Rfail2" value="FAIL&lt;br&gt;withhold final NPZ&lt;br&gt;保留 candidate 与日志" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=3;dashed=1;fontSize=26;fontFamily=Arial;fontColor=#7F1D1D;spacing=10;" vertex="1" parent="1"><mxGeometry x="3025" y="1660" width="255" height="145" as="geometry"/></mxCell>
        <mxCell id="R9" value="Final nominal promotion / export&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;ref&lt;/sub&gt;, q&lt;sub&gt;ref&lt;/sub&gt;, dq&lt;sub&gt;ref&lt;/sub&gt;, x&lt;sub&gt;ref&lt;/sub&gt;, τ&lt;sub&gt;ref&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;τ&lt;sub&gt;ref&lt;/sub&gt;&lt;/span&gt; 仍为 analysis-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=26;fontStyle=1;fontFamily=Arial;fontColor=#14532D;spacing=14;" vertex="1" parent="1"><mxGeometry x="1880" y="1860" width="1400" height="150" as="geometry"/></mxCell>
        <mxCell id="R10" value="FDDP 之后的独立验证（非 solver 本体）&lt;br&gt;MuJoCo full replay: 10 s，20/20 contact events&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt; + Δq&lt;/span&gt;；C0 / C1 / phase-only / C2-final" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=3;dashed=1;fontSize=26;fontFamily=Arial;fontColor=#065F46;spacing=14;" vertex="1" parent="1"><mxGeometry x="1880" y="2070" width="1400" height="155" as="geometry"/></mxCell>
        <mxCell id="footer" value="对比要点：左侧在输出 x*、u* 后结束；右侧在标准 FDDP 求解器之外增加周期 seed、multi-step continuation、双层证据 gate 与独立 MuJoCo/controller validation。" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=26;fontFamily=Arial;fontColor=#374151;" vertex="1" parent="1"><mxGeometry x="220" y="2290" width="2960" height="70" as="geometry"/></mxCell>
