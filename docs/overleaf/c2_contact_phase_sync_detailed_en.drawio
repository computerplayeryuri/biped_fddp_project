        <mxCell id="E_P7_P8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;html=1;strokeColor=#475569;strokeWidth=3;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="P7" target="P8"><mxGeometry relative="1" as="geometry"/></mxCell>
