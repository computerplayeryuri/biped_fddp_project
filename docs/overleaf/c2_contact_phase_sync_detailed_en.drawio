<mxfile host="app.diagrams.net" modified="2026-07-16T00:00:00Z" agent="Codex Drawio Skill" version="24.7.17" type="device">
  <diagram id="c2Detaileden" name="C2 Detailed Flow">
    <mxGraphModel dx="2600" dy="3200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="3200" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C2 - Contact-Event Phase Synchronisation Detailed Flow" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontFamily=Arial;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="2100" height="70" as="geometry"/></mxCell>
        <mxCell id="prepHeader" value="Reference / event preparation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="2000" height="65" as="geometry"/></mxCell>
        <mxCell id="onlineHeader" value="Online phase alignment + C1 correction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#5B21B6;" vertex="1" parent="1"><mxGeometry x="300" y="700" width="2000" height="65" as="geometry"/></mxCell>
        <mxCell id="P1" value="Retain the complete C1 FIR-QP controller&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;h, S, AR, q/r/slew, G&lt;/span&gt;&lt;br&gt;the pitch-recovery law is unchanged" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P2" value="Load scheduled contact transitions from the FDDP reference&lt;br&gt;left / right touchdown and liftoff&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;event,ref&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P3" value="Toe/heel contact observer&lt;br&gt;sensor values → site active → leg active&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;observed events: {leg, kind, t&lt;sub&gt;obs&lt;/sub&gt;}&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="790" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P4" value="Match observed and expected events inside the time window&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;ε&lt;sub&gt;t&lt;/sub&gt; = t&lt;sub&gt;obs&lt;/sub&gt; − t&lt;sub&gt;expected&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;matched / skipped / unmatched" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1040" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P5" value="Compute the bounded phase-offset update&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;Δt&lt;sub&gt;target&lt;/sub&gt; = clip(t&lt;sub&gt;expected&lt;/sub&gt;−t&lt;sub&gt;obs&lt;/sub&gt;, ±Δt&lt;sub&gt;max&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;Δt&lt;sub&gt;φ&lt;/sub&gt;&lt;sup&gt;+&lt;/sup&gt; = clip(Δt&lt;sub&gt;φ&lt;/sub&gt; + clip(K&lt;sub&gt;φ&lt;/sub&gt;(Δt&lt;sub&gt;target&lt;/sub&gt;−Δt&lt;sub&gt;φ&lt;/sub&gt;), ±δt&lt;sub&gt;step&lt;/sub&gt;), ±Δt&lt;sub&gt;max&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1290" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P6" value="Query the phase-aligned reference time&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;φ&lt;/sub&gt; = clip(t + Δt&lt;sub&gt;φ&lt;/sub&gt;,0,T)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1540" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P7" value="Interpolate the nominal reference at phase time&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;nom&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;φ&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;θ&lt;sub&gt;ref&lt;/sub&gt; = θ&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;φ&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1790" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P8" value="Run the unchanged C1 FIR-QP correction&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;e&lt;sub&gt;k&lt;/sub&gt; → E&lt;sub&gt;free&lt;/sub&gt;+SA → A&lt;sup&gt;*&lt;/sup&gt; → α&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2040" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P9" value="Form the runtime position command&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;φ&lt;/sub&gt;) + Gα&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2290" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P10" value="Log phase / contact / pitch / QP evidence&lt;br&gt;matched and skipped events / timing error / phase offset&lt;br&gt;contacts / pitch metrics / correction / solve time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#7C3AED;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2540" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="evidence" value="Current evidence boundary: the double-support CoM-shift reference contains no scheduled contact transition. Contact monitoring, event-capable implementation, and C1 compatibility are supported; walking-gait phase synchronisation is not validated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#7C2D12;spacing=16;" vertex="1" parent="1"><mxGeometry x="300" y="2810" width="2000" height="240" as="geometry"/></mxCell>
