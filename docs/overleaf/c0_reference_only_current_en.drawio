  <diagram id="c0Detaileden" name="C0 Detailed Flow">
    <mxGraphModel dx="2400" dy="2400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2400" pageHeight="2400" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="C0 — Current Ten-Step Reference-Only Baseline" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontFamily=Arial;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="1900" height="70" as="geometry" /></mxCell>
        <mxCell id="section" value="Fixed-Phase Ten-Step Reference Replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#1E3A8A;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="1800" height="70" as="geometry" /></mxCell>
        <mxCell id="P1" value="Load the Accepted Ten-Step FDDP Reference&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;ref&lt;/sub&gt;, q&lt;sub&gt;ref&lt;/sub&gt;, dq&lt;sub&gt;ref&lt;/sub&gt;, state&lt;sub&gt;ref&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;phase / left-right contact / cycle metadata; &lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;τ&lt;sub&gt;ref&lt;/sub&gt;&lt;/span&gt;: analysis only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="230" width="1800" height="170" as="geometry" /></mxCell>
        <mxCell id="P2" value="Keep Motion Phase Fixed; Add Command Advance&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;t&lt;sub&gt;motion&lt;/sub&gt; = t, t&lt;sub&gt;cmd&lt;/sub&gt; = clip(t + 0.030,0,T)&lt;/span&gt;&lt;br&gt;no contact-event phase correction" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="500" width="1800" height="170" as="geometry" /></mxCell>
        <mxCell id="P3" value="Interpolate the Current Baselines&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;nom&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t&lt;sub&gt;cmd&lt;/sub&gt;)&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;θ&lt;sub&gt;ref&lt;/sub&gt; = θ&lt;sub&gt;baseline&lt;/sub&gt;(t)&lt;/span&gt; from the accepted nominal MuJoCo replay" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="770" width="1800" height="170" as="geometry" /></mxCell>
        <mxCell id="P4" value="Apply No Feedback Correction&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α&lt;sub&gt;k&lt;/sub&gt; = 0, Δq&lt;sub&gt;k&lt;/sub&gt; = 0&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1040" width="1800" height="170" as="geometry" /></mxCell>
        <mxCell id="P5" value="Form the Safe Position Command&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;raw&lt;/sub&gt; = q&lt;sub&gt;nom&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = SafetyLimiter(q&lt;sub&gt;raw&lt;/sub&gt;)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1310" width="1800" height="170" as="geometry" /></mxCell>
        <mxCell id="P6" value="Actuator / Delay Proxy and MuJoCo Application&lt;br&gt;position and rate dynamics → data.ctrl → mj_step" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1580" width="1800" height="170" as="geometry" /></mxCell>
        <mxCell id="P7" value="Inject the Pitch Disturbance and Log C0 Metrics&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;e&lt;sub&gt;θ&lt;/sub&gt; = θ&lt;sub&gt;meas&lt;/sub&gt; − θ&lt;sub&gt;baseline&lt;/sub&gt;(t)&lt;/span&gt;&lt;br&gt;IAE / peak error / height / contacts / joint tracking" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1850" width="1800" height="170" as="geometry" /></mxCell>
        <mxCell id="evidence" value="Evidence boundary: C0 is a simulation-only, fixed-phase reference baseline. It contains no FIR-QP correction and no contact-phase correction; it is the baseline for the C1/C2 ablation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#7C2D12;spacing=16;" vertex="1" parent="1"><mxGeometry x="300" y="2120" width="1800" height="170" as="geometry" /></mxCell>
