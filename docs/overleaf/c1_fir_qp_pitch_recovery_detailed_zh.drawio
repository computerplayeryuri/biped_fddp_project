<mxfile host="app.diagrams.net" modified="2026-07-16T00:00:00Z" agent="Codex Drawio Skill" version="24.7.17" type="device">
  <diagram id="c1Detailedzh" name="C1详细流程">
    <mxGraphModel dx="2600" dy="3150" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2600" pageHeight="3150" math="0" shadow="0" background="#FFFFFF">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="C1 - FIR-QP 俯仰扰动恢复详细流程" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=38;fontStyle=1;fontFamily=Arial;fontColor=#111827;" vertex="1" parent="1"><mxGeometry x="250" y="25" width="2100" height="70" as="geometry"/></mxCell>
        <mxCell id="offlineHeader" value="离线辨识 / Offline identification" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="2000" height="65" as="geometry"/></mxCell>
        <mxCell id="onlineHeader" value="在线 Receding-Horizon Control" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=4;fontSize=28;fontStyle=1;fontFamily=Arial;fontColor=#14532D;" vertex="1" parent="1"><mxGeometry x="300" y="920" width="2000" height="65" as="geometry"/></mxCell>
        <mxCell id="P1" value="FDDP nominal + C0-aligned pitch reference&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;ref&lt;/sub&gt;(t), θ&lt;sub&gt;ref&lt;/sub&gt;(t)&lt;/span&gt;&lt;br&gt;固定相位 C1 reference" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="210" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P2" value="经验脉冲响应辨识&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α pulse → root-pitch deviation&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;h = [h&lt;sub&gt;0&lt;/sub&gt;,…,h&lt;sub&gt;M−1&lt;/sub&gt;]&lt;/span&gt;&lt;br&gt;得到 FIR response coefficients" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="460" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P3" value="拟合并稳定化 AR disturbance model&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;d&lt;sub&gt;k&lt;/sub&gt; = Σa&lt;sub&gt;j&lt;/sub&gt;d&lt;sub&gt;k−j&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;检查 / 收缩 spectral radius" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="710" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P4" value="测量俯仰并形成参考对齐误差&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;e&lt;sub&gt;k&lt;/sub&gt; = θ&lt;sub&gt;meas,k&lt;/sub&gt; − θ&lt;sub&gt;ref&lt;/sub&gt;(t)&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1010" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P5" value="减去历史指令的已知延迟响应&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;d&lt;sub&gt;k&lt;/sub&gt; = e&lt;sub&gt;k&lt;/sub&gt; − Σh&lt;sub&gt;i&lt;/sub&gt;α&lt;sub&gt;k−i&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1260" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P6" value="预测自由响应并构造 FIR dynamic matrix&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;E&lt;sub&gt;free&lt;/sub&gt; = E&lt;sub&gt;AR&lt;/sub&gt; + E&lt;sub&gt;past&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;E = E&lt;sub&gt;free&lt;/sub&gt; + SA&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1510" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P7" value="求解 tracking / magnitude / slew QP&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;A&lt;sup&gt;*&lt;/sup&gt; = arg min q∥E&lt;sub&gt;free&lt;/sub&gt;+SA∥&lt;sup&gt;2&lt;/sup&gt; + r∥A∥&lt;sup&gt;2&lt;/sup&gt; + s∥DA-d&lt;sub&gt;prev&lt;/sub&gt;∥&lt;sup&gt;2&lt;/sup&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;|A&lt;sub&gt;i&lt;/sub&gt;| ≤ α&lt;sub&gt;max&lt;/sub&gt;, |Δα| ≤ Δα&lt;sub&gt;max&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="1760" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P8" value="仅执行优化序列的第一个元素&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;α&lt;sub&gt;k&lt;/sub&gt; = A&lt;sub&gt;0&lt;/sub&gt;&lt;sup&gt;*&lt;/sup&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2010" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P9" value="映射为关节修正与位置命令&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;Δq&lt;sub&gt;k&lt;/sub&gt; = Gα&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;q&lt;sub&gt;cmd&lt;/sub&gt; = q&lt;sub&gt;ref&lt;/sub&gt;(t) + Δq&lt;sub&gt;k&lt;/sub&gt;&lt;/span&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2260" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="P10" value="计算并检查 acceptance metrics&lt;br&gt;IAE / peak &amp; final pitch error / min contacts&lt;br&gt;&lt;span style=&quot;font-family:Cambria Math;font-style:italic;&quot;&gt;max |Δq|&lt;/span&gt;&lt;br&gt;/ median &amp; max QP solve time" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16A34A;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#111827;spacing=14;" vertex="1" parent="1"><mxGeometry x="300" y="2510" width="2000" height="180" as="geometry"/></mxCell>
        <mxCell id="evidence" value="证据边界：C1 相对 C0 改善扰动后的恢复性能；它不声称消除扰动施加瞬间的初始峰值。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D97706;strokeWidth=3;fontSize=26;fontFamily=Arial;fontColor=#7C2D12;spacing=16;" vertex="1" parent="1"><mxGeometry x="300" y="2790" width="2000" height="190" as="geometry"/></mxCell>
